{
  "name": "wa-agent",
  "version": "0.2.0",
  "private": true,
  "description": "Espelho read-only do WhatsApp para Supabase, com triagem por IA e digest priorizado",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/listener.js",
    "testar": "node src/testar.js",
    "worker": "node src/worker.js",
    "digest": "node src/digest.js",
    "buscar": "node src/buscar.js",
    "indexar": "node src/indexar.js",
    "classificar": "node src/classificar.js",
    "status": "node src/status.js",
    "check": "for f in src/*.js; do node --check \"$f\" || exit 1; done && echo 'sintaxe ok'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@whiskeysockets/baileys": "^6.7.9",
    "dotenv": "^16.4.5",
    "pino": "^9.4.0",
    "qrcode-terminal": "^0.12.0"
  }
}
