# Copie para .env e preencha. NUNCA commite o .env.
#   cp .env.example .env && chmod 600 .env

# Supabase — projeto DEDICADO a este agente.
# Nao reaproveite o projeto da base corporativa da Duty: aqui ha conversa
# de terceiros, a separacao e decisao de LGPD (CLAUDE.md secao 9.3).
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# service_role, nao a anon. O RLS fica ligado sem policy publica,
# entao a anon key nao enxerga nada de proposito.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API — usada pelo worker de triagem e pelo classificar.js.
# O listener nao precisa dela para rodar.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# So mexa nisto para proxy corporativo ou teste. Vazio = API oficial.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# JID do proprio Jean, formato 55DDDNUMERO@s.whatsapp.net
# Opcional: o listener descobre sozinho apos o pareamento e loga o valor.
MEU_JID=

# Ajustes do listener
BUFFER_MS=5000
BUFFER_MAX=200
LOG_LEVEL=info
